{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ekco-S64QTN6/ghidra-tools/blob/main/schemas/capability-rule-v1.schema.json",
  "title": "ghidra-report Capability Rule Schema 1.0.0",
  "description": "Strict schema for the file-aggregate ghidra-report rule DSL. This is not a capa rule schema.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "namespace",
    "scope",
    "meta",
    "features"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^ghidra\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "const": "file"
    },
    "meta": {
      "type": "object",
      "required": [
        "att&ck",
        "mbc",
        "weight",
        "description",
        "rationale",
        "references"
      ],
      "properties": {
        "att&ck": {
          "type": "string",
          "pattern": "^T[0-9]{4}(?:\\.[0-9]{3})?$"
        },
        "mbc": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      },
      "additionalProperties": false
    },
    "features": {
      "$ref": "#/definitions/feature"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "feature": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "and"
          ],
          "properties": {
            "and": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/feature"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "or"
          ],
          "properties": {
            "or": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/feature"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/definitions/feature"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "count"
          ],
          "properties": {
            "count": {
              "type": "object",
              "required": [
                "items"
              ],
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/feature"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "api"
          ],
          "properties": {
            "api": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "indicator"
          ],
          "properties": {
            "indicator": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "section_name"
          ],
          "properties": {
            "section_name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "section_rwx"
          ],
          "properties": {
            "section_rwx": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ioc"
          ],
          "properties": {
            "ioc": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
