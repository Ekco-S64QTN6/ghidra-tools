#!/usr/bin/env bash
# Installed package launcher template; packaging supplies the application root at build time.
set -euo pipefail

APP_ROOT="@APP_ROOT@"
if [[ ! -r "$APP_ROOT/ghidra-report.sh" ]]; then
    echo "[ERROR] ghidra-report runtime files not found under: $APP_ROOT" >&2
    exit 1
fi

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export GHIDRA_REPORT_DATA_DIR="${GHIDRA_REPORT_DATA_DIR:-$DATA_HOME/ghidra-report}"
if [[ -d "$APP_ROOT/vendor" ]]; then
    export PYTHONPATH="$APP_ROOT/vendor${PYTHONPATH:+:$PYTHONPATH}"
fi

exec "$APP_ROOT/ghidra-report.sh" "$@"
