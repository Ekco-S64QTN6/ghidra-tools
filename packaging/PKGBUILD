# Maintainer: Not assigned (replace before submitting to AUR)
pkgname=ghidra-report
pkgver=0.2.0
pkgrel=1
pkgdesc="Automated binary analysis, threat triage, and firmware carving toolkit powered by Ghidra"
arch=('x86_64')
url="https://github.com/Ekco-S64QTN6/ghidra-tools"
license=('MIT')
depends=('bash' 'python' 'python-yaml' 'sqlite' 'java-runtime>=25')
optdepends=(
    'ghidra: Full reverse engineering framework'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/Ekco-S64QTN6/ghidra-tools/archive/refs/tags/v${pkgver}.tar.gz")
# Release tag/checksum not published yet; replace before submitting to AUR.
sha256sums=('SKIP')

package() {
    app_root="$pkgdir/usr/lib/ghidra-report/app"
    install -d "$app_root"
    install -Dm755 ghidra-report.sh "$app_root/ghidra-report.sh"
    install -Dm755 run-headless.sh "$app_root/run-headless.sh"
    install -Dm644 VERSION "$app_root/VERSION"
    install -Dm644 requirements-rules.txt "$app_root/requirements-rules.txt"
    cp -r scripts rules schemas "$app_root/"

    install -Dm755 packaging/ghidra-report-launcher.sh.in "$pkgdir/usr/bin/ghidra-report"
    sed -i 's|@APP_ROOT@|/usr/lib/ghidra-report/app|g' "$pkgdir/usr/bin/ghidra-report"

    install -Dm644 ghidra-report.1 "$pkgdir/usr/share/man/man1/ghidra-report.1"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
